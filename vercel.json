{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/engagement/reminders/run",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/billing/sync/run",
      "schedule": "0 12 * * *"
    }
  ]
}
