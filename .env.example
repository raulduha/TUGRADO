# Copia este archivo a .env y ajusta los valores. .env no se versiona.
POSTGRES_DB=tugrado
POSTGRES_USER=tugrado
POSTGRES_PASSWORD=cambia-esta-clave
# Puerto en el host (solo 127.0.0.1). Cámbialo si 5432 está ocupado.
POSTGRES_PORT=5432

# Backend. Desde el host usa 127.0.0.1 (en Windows, "localhost" intenta IPv6 primero y tarda minutos); dentro de Docker el compose lo reemplaza por el host "db".
DATABASE_URL=postgresql+psycopg://tugrado:cambia-esta-clave@127.0.0.1:5432/tugrado
# Puerto del backend en el host (solo 127.0.0.1).
BACKEND_PORT=8000

# Reglas de tiempo de la simulación (valores confirmados en README; obligatorios, sin valor por defecto en el código).
SESSION_EXTENSION_SECONDS=60
SESSION_MAX_EXTENSIONS_PER_QUESTION=1
SESSION_EXTENSION_OFFER_WINDOW_SECONDS=15
SESSION_HEARTBEAT_INTERVAL_SECONDS=10
SESSION_HEARTBEAT_TIMEOUT_SECONDS=30
SESSION_RECOVERY_WINDOW_SECONDS=1800
SESSION_VOLUNTARY_PAUSE_MAX_SECONDS=30
SESSION_VOLUNTARY_PAUSES_PER_SESSION=1

# Base de datos de pruebas de integración (se crea y migra sola al correr pytest).
TEST_DATABASE_URL=postgresql+psycopg://tugrado:cambia-esta-clave@127.0.0.1:5432/tugrado_test

# Autenticación (valores confirmados en README; obligatorios, sin valor por defecto en el código).
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=604800
AUTH_SESSION_MAX_AGE_SECONDS=2592000
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900
# En local se usa http; en producción debe ser true.
AUTH_COOKIE_SECURE=false
# Origen del frontend: base de los enlaces de correo y único origen aceptado en operaciones que modifican datos.
FRONTEND_BASE_URL=http://localhost:3000
